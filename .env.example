# Copy to .env.local and fill in the values. Never commit .env.local.
# NEXT_PUBLIC_* values are sent to the browser. Everything else stays on the server.

# Supabase (step 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# OpenAI (step 3): embeddings, chat, text-to-speech
OPENAI_API_KEY=

# Upstash Redis (step 4): rate limiting per user
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
